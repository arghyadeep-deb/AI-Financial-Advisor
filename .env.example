# Copy to .env and fill in. Never commit .env.
# Environment: development | test | production (unknown values are treated as production).
APP_ENV=development

# Token signing key. REQUIRED (>= 32 random chars) outside development; dev generates an ephemeral one.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated previous signing keys accepted during rotation (verify only).
SECRET_KEY_PREVIOUS=
# Only needed to let pre-existing users with legacy password hashes log in once (they are re-hashed with Argon2id).
LEGACY_PASSWORD_SECRET=

# Database. SQLite is fine locally; production-like environments require PostgreSQL.
DATABASE_URL=sqlite:///./advisor.db
AUTO_MIGRATE=true

# Browser origins allowed to call the API (no wildcard in production).
CORS_ORIGINS=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Model providers (all optional - with none configured the app returns deterministic, clearly labelled fallbacks).
GROQ_API_KEY_1=
GOOGLE_API_KEY_1=
OPENROUTER_API_KEY=

# Feature flags (default off).
NAMED_PRODUCT_RECOMMENDATIONS=false
# Metadata-only LangSmith export. Needs BOTH this flag and LANGCHAIN_API_KEY.
TELEMETRY_EXPORT_ENABLED=false
LANGCHAIN_API_KEY=
LOG_LEVEL=INFO
